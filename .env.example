# Copy to .env and fill in. Never commit .env.

# Which model provider to use: anthropic | openai
LLM_PROVIDER=anthropic
# Leave empty for the default (anthropic: claude-opus-5-5, openai: gpt-5)
LLM_MODEL=

# API keys: set only the one for your provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible server. For local Ollama (no key needed):
#   LLM_PROVIDER=openai  LLM_MODEL=qwen3:8b
# OPENAI_BASE_URL=http://localhost:11434/v1

# Anthropic-only tuning
ANTHROPIC_EFFORT=medium          # low | medium | high (empty = model default)
ANTHROPIC_FALLBACKS=default      # server-side refusal fallback; "off" to disable

# Reproducibility: the agent treats this as "today"
INVESTIGATION_DATE=2026-03-16

# Safety limits
MAX_TOOL_CALLS=8
MAX_MODEL_TURNS=12

# Paths (defaults shown)
# DB_PATH=data/supply_chain.db
# TRACE_DIR=traces

# Fault injection: comma-separated tool names that simulate an outage
FAIL_TOOLS=

# Website (python -m scagent web)
# Set an access code before sharing the site: every visitor's run uses your API key.
WEB_ACCESS_CODE=
WEB_MAX_CONCURRENT=2
